COMPOSE_PROJECT_NAME=chilowallet

DB_HOST=db
DB_NAME=mydb
DB_USER=admin
DB_PASS=password
# This was inserted by `prisma init`:
# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://admin:password@db:5432/mydb?schema=public"

# One of 'fatal', 'error', 'warn', 'info', 'debug', 'trace' or 'silent'.
LOG_LEVEL=info
LOG_MAX_SIZE=100m
LOG_MAX_FILE=7
DUMP_BACKUP_DIR=/var/chilowallet/db_dump_backup
DUMP_BACKUP_COUNT=7

# Open Badge検証サービス（openbadges-validator-core）のビルド元（Gitリポジトリ#ブランチ またはローカルのディレクトリ）
BADGE_VERIFIER_BUILD_CONTEXT=https://github.com/npocccties/openbadges-validator-core.git#ties-v1.0.1
# Open Badge検証サービスが取得してよいホスト名（カンマ区切り。バッジを発行するMoodleのホスト名）
ALLOWED_FETCH_HOSTS=lms.example.org

# Open Badge 検証サービスの異常・復旧の通知先（check_badge_verifier.sh が使用。任意）
BADGE_VERIFIER_ALERT_WEBHOOK_URL=
BADGE_VERIFIER_ALERT_MAIL_TO=

# 検証サービスが unhealthy のとき、再起動する上限回数（任意。既定 3）
BADGE_VERIFIER_MAX_RESTARTS=